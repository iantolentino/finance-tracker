# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- GitHub-as-database storage ---
# All application data (customers, purchases, loans, budgets, backups, the
# master password) is stored as JSON files committed to a GitHub repo via
# the GitHub REST API, since Vercel's filesystem is read-only/ephemeral.
#
# GITHUB_TOKEN: Personal Access Token with Contents: Read & write on the
# repo below (fine-grained PAT scoped to just this repo is recommended).
# Keep this repo PRIVATE - it will contain plaintext financial data and
# the master password.
GITHUB_TOKEN="MY_GITHUB_PAT"

# GITHUB_OWNER: GitHub username or org that owns the data repo.
GITHUB_OWNER="MY_GITHUB_USERNAME"

# GITHUB_REPO: Name of the (private) repo used to store data/ and backups/.
GITHUB_REPO="MY_REPO_NAME"

# GITHUB_BRANCH: Branch to read/write data on. Defaults to "main" if unset.
GITHUB_BRANCH="main"
