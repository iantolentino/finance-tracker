# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Database (Vercel Postgres / Neon) ---
# All application data (customers, purchases, loans, budgets, backups) is
# stored in Postgres, since Vercel's filesystem is read-only/ephemeral.
# Provisioned from the Vercel dashboard's Storage tab (Create Database ->
# Postgres/Neon), which auto-injects this connection string into the
# project's Production/Preview env vars.
#
# For local dev: this value is marked "Sensitive" by Vercel and can't be
# retrieved via `vercel env pull` - copy it manually from the Vercel
# dashboard (Project -> Settings -> Environment Variables) if you need to
# run against the real database locally.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# --- Sessions ---
# Multiple accounts (each with their own username/password and fully
# separate data) are supported. Login issues a JWT signed with this secret
# instead of comparing a shared plaintext master password. Generate a long
# random value once, e.g.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET="MY_RANDOM_SESSION_SECRET"
